{
  "name": "nap-code-cho-bia",
  "version": "1.3.0",
  "description": "NAP CODE - ESP32/S3/C3 Flasher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.15.0"
  },
  "build": {
    "appId": "com.esp.napcode",
    "productName": "NAP CODE CHo BIA",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "index.html", "bundle.js", "icon.ico"],
    "win": {
      "icon": "icon.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "portable": { "artifactName": "NapCodeChoBia.exe" }
  }
}
